{
  "info": {
    "name": "API Gestión de Recursos del Pesebre",
    "description": "Casos de prueba: 201/200, 400, 401, 403, 404, 409, 422 y 202 (SOAP caído).\nAntes de ejecutar: levantar la API (php artisan serve) y el mock SOAP (php -S 127.0.0.1:8081 mock-soap/server.php).\nEjecutar en orden con el Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Recursos - casos felices y errores",
      "item": [
        {
          "name": "201 - Crear recurso (ENCARGADO)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('recursoId', b.id);",
                  "pm.test('Regla 1: 5 < stockMinimo => BAJO_STOCK', () => pm.expect(b.estado).to.eql('BAJO_STOCK'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEncargado}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recursos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recursos"
              ]
            },
            "description": "Creación exitosa. Guarda el id en {{recursoId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Paja fresca {{$timestamp}}\",\n  \"categoria\": \"PAJA\",\n  \"cantidad\": 5,\n  \"stockMinimo\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
